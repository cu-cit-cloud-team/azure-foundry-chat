{
  "folders": [
    {
      "path": ".",
    },
  ],
  "settings": {
    "[javascript]": {
      "editor.defaultFormatter": "oxc.oxc-vscode",
    },
    "[json]": {
      "editor.defaultFormatter": "oxc.oxc-vscode",
    },
    "[jsonc]": {
      "editor.defaultFormatter": "oxc.oxc-vscode",
    },
    "[jsonl]": {
      "editor.defaultFormatter": "oxc.oxc-vscode",
    },
    "[typescript]": {
      "editor.defaultFormatter": "oxc.oxc-vscode",
    },
    "[typescriptreact]": {
      "editor.defaultFormatter": "oxc.oxc-vscode",
    },
    "editor.codeActionsOnSave": {
      "source.organizeImports": "always",
      "source.format.oxc": "always",
      "source.fixAll.oxc": "explicit",
    },
    "cSpell.enabled": true,
    "cSpell.words": [
      "aoai",
      "argmax",
      "Autofocus",
      "autorestart",
      "cmdk",
      "codespan",
      "deepseek",
      "listitem",
      "oklch",
      "SAMEORIGIN",
      "shadcn",
      "shiki",
      "Tabindex",
      "tablecell",
      "tablerow",
      "tokenlens",
      "turbopack",
      "unitless",
      "Xmark",
      "xyflow",
    ],
  },
  "extensions": {
    "recommendations": [
      "oxc.oxc-vscode",
      "streetsidesoftware.code-spell-checker",
    ],
  },
}
