{
  "name": "azure-foundry-chat",
  "version": "1.0.0-beta.65",
  "description": "Private streaming chat bot experience powered by Azure AI Foundry",
  "private": true,
  "engines": {
    "node": ">= 24.x",
    "npm": ">= 11.x"
  },
  "packageManager": "npm@12.2.1",
  "scripts": {
    "build": "next build",
    "changelog": "conventional-changelog -p conventionalcommits -n changelog.config.mjs -i CHANGELOG.md -s && git add CHANGELOG.md",
    "changelog:preview": "conventional-changelog -p conventionalcommits -n changelog.config.mjs -u --stdout -i /dev/null",
    "dev": "next dev -p 3001 --webpack",
    "dev:turbo": "next dev -p 3001",
    "format": "oxfmt app",
    "format:check": "oxfmt --check app",
    "lint": "oxlint app",
    "lint:eslint": "eslint .",
    "start": "next start",
    "test": "npm run lint && npm run format:check && npm run typecheck",
    "typecheck": "tsc --noEmit",
    "version": "npm run changelog"
  },
  "keywords": [],
  "repository": {
    "url": "https://github.com/cu-cit-cloud-team/azure-foundry-chat"
  },
  "author": {
    "name": "Michael Sprague",
    "email": "ms388@cornell.edu"
  },
  "homepage": "https://github.com/cu-cit-cloud-team/azure-foundry-chat",
  "license": "MIT",
