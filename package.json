{
  "name": "azure-foundry-chat",
  "version": "1.0.0-beta.50",
  "description": "Private streaming chat bot experience powered by Azure AI Foundry",
  "private": true,
  "engines": {
    "node": ">= 24.x",
    "npm": ">= 11.x"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "build": "npx next build",
    "changelog": "npx conventional-changelog -p conventionalcommits -n changelog.config.mjs -i CHANGELOG.md -s && git add CHANGELOG.md",
    "changelog:preview": "npx conventional-changelog -p conventionalcommits -n changelog.config.mjs -u --stdout -i /dev/null",
    "dev": "npx next dev -p 3001 --webpack",
    "dev:turbo": "npx next dev -p 3001",
    "format": "npx oxfmt app",
    "format:check": "npx oxfmt --check app",
    "lint": "npx oxlint app",
    "lint:eslint": "npx eslint .",
    "start": "npx next start",
    "test": "npm run lint && npm run format:check && npm run typecheck",
    "typecheck": "npx tsc --noEmit",
    "version": "npm run changelog"
  },
  "keywords": [],
  "repository": {
    "url": "https://github.com/cu-cit-cloud-team/azure-foundry-chat"
  },
  "author": {
    "name": "Michael Sprague",
