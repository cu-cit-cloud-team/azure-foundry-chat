# your Azure Foundry base path
AZURE_FOUNDRY_ENDPOINT="https://your-deployment-name.services.ai.azure.com"

# your Azure Foundry OpenAI compatible endpoint (used by xAI client)
AZURE_FOUNDRY_OPENAI_COMPATIBLE_ENDPOINT="https://your-deployment-name.openai.azure.com/openai/v1"

# your Azure Foundry deployment name
AZURE_FOUNDRY_RESOURCE_NAME="your-deployment-name"

# your Azure Foundry api key (used for all deployed models)
AZURE_FOUNDRY_API_KEY="xxxxxxxx"

# use your deployed OpenAI model names (not the model release names)
AZURE_OPENAI_API_PATH="/openai/v1/chat/completions"
AZURE_OPENAI_GPT54_MINI_DEPLOYMENT="your-deployment-gpt-5.4-mini"
AZURE_OPENAI_GPT54_NANO_DEPLOYMENT="your-deployment-gpt-5.4-nano"
AZURE_OPENAI_GPT56_LUNA_DEPLOYMENT="your-deployment-gpt-5.6-luna"
AZURE_OPENAI_GPT56_TERRA_DEPLOYMENT="your-deployment-gpt-5.6-terra"
AZURE_OPENAI_GPT56_SOL_DEPLOYMENT="your-deployment-gpt-5.6-sol"

# image model to be used for image generation in conversation with gpt models
AZURE_OPENAI_GPT_IMAGE_DEPLOYMENT="gpt-image-2-1"

# use your deployed Anthropic model names (not the model release names)
AZURE_ANTHROPIC_API_PATH="/anthropic/v1/messages"
AZURE_ANTHROPIC_API_VERSION="2023-06-01"
AZURE_ANTHROPIC_CLAUDE_HAIKU_45_DEPLOYMENT="your-deployment-claude-haiku-4-5"
AZURE_ANTHROPIC_CLAUDE_SONNET_5_DEPLOYMENT="your-deployment-claude-sonnet-5"
AZURE_ANTHROPIC_CLAUDE_OPUS_5_DEPLOYMENT="your-deployment-claude-opus-5"

# use your deployed DeepSeek model names (not the model release names)
AZURE_DEEPSEEK_API_PATH="/models/"
AZURE_DEEPSEEK_V4_FLASH_DEPLOYMENT="your-deployment-deepseek-v4-flash"
AZURE_DEEPSEEK_V4_PRO_DEPLOYMENT="your-deployment-deepseek-v4-pro"

# use your deployed xAI model names (not the model release names)
AZURE_XAI_GROK_4_3_DEPLOYMENT="your-deployment-grok-4.3"

# will be added to the website title, should only be set in local/dev environments
NEXT_PUBLIC_WEBSITE_TITLE_PREFIX="LOCAL"
